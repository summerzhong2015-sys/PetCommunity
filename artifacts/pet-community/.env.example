# Copy to .env.local to override any of these. All are optional.
#
# Accounts are off unless a Clerk publishable key is present. Without one the
# app runs signed-out: profiles, posts, saved pets and giving are kept in the
# browser instead. Get a key at https://dashboard.clerk.com (the pk_test_ one).
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
#
# Only needed when Clerk is served through a proxy.
# VITE_CLERK_PROXY_URL=
